# Public origin used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.textsnapy.com
# Shown on Contact/About/legal pages. Use a mailbox you actually read.
NEXT_PUBLIC_CONTACT_EMAIL=

# Analytics (cookieless). Leave provider empty to disable.
# provider: umami | plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=

# Google AdSense. Loader + ads.txt are always on; manual slots need ADS_ENABLED=true and a slot id.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
